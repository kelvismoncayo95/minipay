# Copiar a .env y completar. NUNCA subir el .env a git.

# Base local (docker compose)
POSTGRES_USER=minipay
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_DB=minipay

# Para correr alembic y pytest desde el venv (fuera de Docker)
DATABASE_URL=postgresql+psycopg://minipay:cambiar-esto@localhost:5432/minipay
REDIS_URL=redis://localhost:6379/0

# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generar-uno-largo-y-aleatorio
